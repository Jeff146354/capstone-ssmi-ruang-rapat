@startuml Development Architecture - IPB Reserve
!theme plain
skinparam roundcorner 8

node "Developer Machine (localhost)" as dev {

    node "Docker Engine" as docker {

        rectangle "Frontend Container\n(yiisoftware/yii2-php:8.1-apache)\nPort 20080 → :80" as frontend {
            component "Yii2 Frontend App" as fapp
            note right of fapp
              User-facing:
              - Browse rooms
              - Make bookings
              - View history
              - Notifications
              - Google SSO
            end note
        }

        rectangle "Backend Container\n(yiisoftware/yii2-php:8.1-apache)\nPort 21080 → :80" as backend {
            component "Yii2 Backend App" as bapp
            note right of bapp
              Admin panel:
              - Approve/reject
              - Manage rooms
              - Settings & Rules
              - Strike management
              - Dashboard stats
            end note
        }

        database "MySQL 5.7\nPort 3306 (internal only)\nDB: yii2advanced" as db {
        }
    }

    rectangle "Source Code\n(mounted as volume ./:/app)" as code
}

cloud "External (Internet)" as ext {
    component "Firebase Auth\n(Google SSO)" as firebase
}

frontend --> db : MySQL TCP
backend --> db : MySQL TCP
frontend ..> firebase : Token verification
code --> frontend : Docker volume mount
code --> backend : Docker volume mount

actor "User" as user
actor "Admin" as admin

user --> frontend : http://localhost:20080
admin --> backend : http://localhost:21080

@enduml
